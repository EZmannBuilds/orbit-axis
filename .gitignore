# ── Dependencies ──
node_modules/

# ── Secrets & env (never commit) ──
.env
.env.local
.env.*.local
*.env
# .env.example (placeholders only) IS tracked and is not matched above.

# ── Keys / tokens / credentials ──
*.pem
*.key
*.p12
secrets/
credentials/
tokens/

# ── Logs / cache / build ──
*.log
npm-debug.log*
.cache/
.orbit/
supabase/.temp/
dist/
build/

# ── OS cruft ──
.DS_Store
._*

# Local Supabase CLI state
supabase/.branches/

# ── Vercel ──
# `vercel link` / `vercel build` write project ids, org ids, and pulled
# environment values here. None of it belongs in the repository.
.vercel/

# Obsidian mirror: internal project-management notes, not needed to build
# the app and not appropriate for a public repository. Canonical copy lives in
# the Orbit vault.
07 Orbit App/
.vercel

# Local QA session hand-off (never committed)
public/qa-local-session.json

# Claude Code. `.claude/launch.json` IS tracked — it documents how to start the
# dev server and is the same for everyone. Everything else under here is local:
# `worktrees/` in particular holds whole checkouts (34 MB at the time of
# writing), and one careless `git add .claude/` would commit all of them.
.claude/*
!.claude/launch.json
