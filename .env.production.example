# Orbit Axis — PRODUCTION template (Update 4.0.2, revised 4.0.3)
#
# Placeholders only. Real production values belong in the deployment platform's
# environment settings, never in a file in this repository. On Vercel that means
# the project's Environment Variables scoped to the Production environment.
#
# Orbit refuses to start in production mode with a localhost database, with no
# anon key, or with an unreadable Supabase URL.
#
# See docs/deployment/environment-variables.md for the full inventory of every
# variable Orbit reads, who supplies it, and where it belongs.

# Vercel sets VERCEL=1 and VERCEL_ENV=production automatically, and Orbit maps
# VERCEL_ENV=production to its own "production" environment. Setting this
# explicitly is optional but makes the intent visible in the dashboard.
ORBIT_ENVIRONMENT=production

# The hosted Supabase project.
SUPABASE_URL=https://<project-ref>.supabase.co
# Browser-safe. Row-level security is what protects the data.
SUPABASE_ANON_KEY=<hosted anon key>

# Server-only. Bypasses row-level security — never expose it to a browser and
# only set it if a server operation genuinely requires it.
#
# Orbit refuses to start a shared-database production deployment that holds
# this key UNLESS the two variables below authorize it for one named purpose.
# That refusal is deliberate and is not removed: the same rule is absolute for
# Preview, where no authorization exists at all.
# SUPABASE_SERVICE_ROLE_KEY=<hosted service-role key>

# Narrow service-role authorization (Dev Update 1.2).
#
# Account deletion requires the Supabase Admin API, which requires the key
# above. These two variables authorize it for THAT OPERATION ONLY. Both must be
# set, the purpose must match exactly, and the project reference must
# independently agree with SUPABASE_URL — a value copied into the wrong
# project's environment fails closed.
#
# A second use of the service-role key requires its own purpose, added
# deliberately in lib/env/service-role.js. This is not a general unlock.
# ORBIT_PRODUCTION_SERVICE_ROLE_PURPOSE=account-deletion
# ORBIT_PRODUCTION_SERVICE_ROLE_PROJECT_REF=<project-ref>
#
# Dev Update 6.1: the Orbit X automatic channel is a third named purpose. To
# let it write, the list must include it, e.g.
# ORBIT_PRODUCTION_SERVICE_ROLE_PURPOSE=account-deletion,stripe-billing,orbit-x-channel
# Leave it out and the channel's cron route answers 503 without writing.

# Ask Orbit uses its built-in deterministic formatter in production.
# A local model is never reachable from a deployment.
ORBIT_ASK_USE_MODEL=false

# Orbit X automatic channel (Dev Update 6.1). Off unless set; see
# docs/orbit-x.md for the order. Never commit real values.
# ORBIT_X_AUTOPUBLISH=true
# ORBIT_X_AUTOPUBLISH_LIVE=true
# ORBIT_X_AUTOPUBLISH_YELLOW=false
# ORBIT_X_KILL_SWITCH=
# CRON_SECRET=<random, 16+ characters>
# ORBIT_X_IG_API=instagram
# ORBIT_X_IG_USER_ID=<numeric Instagram professional account id>
# ORBIT_X_IG_ACCESS_TOKEN=<long-lived token>
# ORBIT_X_IG_TOKEN_EXPIRES_AT=<YYYY-MM-DD>
